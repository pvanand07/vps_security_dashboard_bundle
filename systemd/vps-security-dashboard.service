[Unit]
Description=VPS Security Dashboard
After=network.target

[Service]
Type=simple
User=vpsdash
Group=adm
WorkingDirectory=/opt/vps-security-dashboard
ExecStart=/opt/vps-security-dashboard/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
